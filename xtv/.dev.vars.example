# Xtv - Cloudflare Pages 本地预览环境变量示例
# 复制为 .dev.vars 后填入实际值（.dev.vars 已被 .gitignore 忽略）
#
# 线上部署请在 Cloudflare Dashboard → Pages → Settings → Environment variables 中配置

# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址
# 60S_API_BASE=https://60s.viki.moe

# 可选：是否放行内网直播地址（自建 IPTV）
# LIVE_ALLOW_PRIVATE=0

# 可选：调试
DEBUG=false
